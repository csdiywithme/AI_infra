filters:
  and:
    - file.ext == "md"
    - type != null
    - not:
        - file.inFolder("templates")
properties:
  file.name:
    displayName: 笔记
  topics:
    displayName: 主题
  phase:
    displayName: 实验阶段
  result:
    displayName: 实验结果
views:
  - type: table
    name: 实验
    filters:
      and:
        - type == "experiment"
    order:
      - file.name
      - phase
      - result
      - topics
      - run_date
